{
	"name": "DelimitedText2",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"schema_name": {
				"type": "string"
			},
			"table_name": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().table_name",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(\n    dataset().schema_name,\n    '/',\n    formatDateTime(utcNow(),'yyyy-MM-dd_HH-mm-ss')\n)",
					"type": "Expression"
				},
				"fileSystem": "bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "1",
				"type": "String"
			},
			{
				"name": "Ravi Sharma",
				"type": "String"
			},
			{
				"name": "North",
				"type": "String"
			},
			{
				"name": "ravi.sharma@example.com",
				"type": "String"
			},
			{
				"name": "2024-01-05 09:30:00.0000000",
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}