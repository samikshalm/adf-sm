{
	"name": "fortimestamp",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"schema_name_tstamp": {
				"type": "string"
			},
			"table_name_tstamp": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().table_name_tstamp",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(\n    dataset().schema_name_tstamp,\n    '/',\n    formatDateTime(utcNow(),'yyyy-MM-dd_HH-mm-ss')\n)",
					"type": "Expression"
				},
				"fileSystem": "bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}