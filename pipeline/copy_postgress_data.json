{
	"name": "copy_postgress_data",
	"properties": {
		"activities": [
			{
				"name": "Copy_data_from_pgsql",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": "select * from public.hospitals",
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "PostgreSqlTables",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "pgsql_to_adls",
						"type": "DatasetReference",
						"parameters": {
							"container": "ctlanding",
							"folder": "testfromplsql"
						}
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-11-09T12:26:11Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}